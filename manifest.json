{
  "manifest_version": 3,
  "name": "Tsuzukuyomi",
  "version": "1.0.0",
  "description": "Vocabulário japonês com Anki no seu fluxo de trabalho",
  "permissions": ["storage", "tabs", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:8765/*", "<all_urls>"],
  "background": {
    "service_worker": "src/background/index.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
